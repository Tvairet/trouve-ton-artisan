<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Liste des categories</title>
  <link rel="stylesheet" href="../../frontend/source/index.css">
</head>
<body>
    <header>
    
  </header>
  <h1>Liste des categories</h1>
  <table>
    <thead>
      <tr>
        <th>id</th>
        <th>Nom</th>       
      </tr>
    </thead>
    <tbody>
      <% categories.forEach(Category => { %>
        <tr>
          <td><%= Category.id %></td>
          <td><%= Category.name %></td>                 
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>